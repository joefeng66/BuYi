# Default deny: a public repository exposes source files as well as dist.
# New files need an explicit review before being added to this allowlist.
/*
!/.gitignore
!/README.md
!/LICENSE
!/release-policy.json
!/COPYRIGHT-EXCLUSIONS.txt
!/build.py
!/suite.css
!/suite.js
!/scripts/
/scripts/*
!/scripts/release.py
!/scripts/release_rights.py
!/scripts/verify_release.py
!/scripts/bridge.js
!/scripts/formula-indications.js
!/scripts/formula-references.js
!/scripts/formula-variant-indications.js
!/scripts/meridians-ui.js
!/scripts/script-display.js
!/scripts/script-search.js
!/scripts/theme.js
!/scripts/wuxing-focus.js
!/scripts/wuxing-state.js
!/scripts/wuxing-table.js
!/scripts/wuxing-type.js
!/scripts/wuxing-views.js
!/scripts/wuxing-yinyang.js
!/styles/
/styles/*
!/styles/formulas.css
!/styles/meridians-ui.css
!/styles/meridians.css
!/styles/theme.css
!/styles/wuxing-focus.css
!/styles/wuxing-views.css
!/styles/wuxing-yinyang.css
!/styles/wuxing.css
!/vendor/
/vendor/*
!/vendor/opencc-js/
/vendor/opencc-js/*
!/vendor/opencc-js/opencc.js
!/vendor/opencc-js/LICENSE
!/vendor/opencc-js/THIRD_PARTY_LICENSES.md
!/vendor/opencc-js/provenance.json
!/vendor/opencc-js/LICENSES/
/vendor/opencc-js/LICENSES/*
!/vendor/opencc-js/LICENSES/Apache-2.0.txt
!/tests/
/tests/*
!/tests/release_test.py
!/tests/release-browser.cjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml

# Defense in depth, including inside allowlisted directories.
**/.DS_Store
**/__pycache__/
*.py[cod]
**/node_modules/
**/.cache/
**/.env
**/.env.*
*.log
*.bak
*.orig
*.tmp
* 2.*
*.pdf
*.wav
*.m4a
*.mp3
*.png
*.jpg
*.jpeg
*.webp
*.zip
*.tar
*.gz
*.pem
*.key
# originals/, content/, index.html (screenshot tracings), docs/, backups/,
# evidence/, dist/ and .release-private/ remain local through default deny.
